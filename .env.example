# =========================
# Google Maps / Places
# =========================
# Browser key: restrict by HTTP referrer/domain and allow Maps JavaScript API only.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional custom Map ID. If empty, the app uses Google's DEMO_MAP_ID for Advanced Markers.
NEXT_PUBLIC_GOOGLE_MAP_ID=

# Server-only key: restrict to Places API (New). Never prefix this with NEXT_PUBLIC_.
GOOGLE_MAPS_SERVER_API_KEY=

# =========================
# Neon PostgreSQL
# =========================
# POOLED connection from Neon (hostname normally contains "-pooler").
# Used by the running Next.js application.
DATABASE_URL=

# DIRECT connection from Neon (hostname does NOT contain "-pooler").
# Used by Prisma CLI for migrations, introspection, and Prisma Studio.
DIRECT_URL=
